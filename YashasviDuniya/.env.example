# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yashasvi
POSTGRES_USER=yashasvi_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://yashasvi_user:change_me@postgres:5432/yashasvi

# JWT Configuration
JWT_SECRET=replace_with_strong_value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SSO Configuration (Optional)
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTH_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_REDIRECT_URI=http://localhost/auth/callback

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api

# Docker Registry
DOCKER_REGISTRY=
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASS=
