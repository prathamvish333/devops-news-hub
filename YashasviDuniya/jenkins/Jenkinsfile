pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = credentials('docker-registry')
        DOCKER_REGISTRY_URL = "${env.DOCKER_REGISTRY_URL}"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        KUBECONFIG = credentials('kubeconfig')
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Run Backend Tests') {
            steps {
                dir('backend') {
                    sh '''
                        python -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                        pytest app/tests/ -v --junitxml=test-results.xml
                    '''
                }
            }
            post {
                always {
                    junit 'backend/test-results.xml'
                }
            }
        }
        
        stage('Build Frontend Image') {
            steps {
                dir('frontend') {
                    script {
                        docker.build("${DOCKER_REGISTRY_URL}/yashasvi-frontend:${IMAGE_TAG}")
                    }
                }
            }
        }
        
        stage('Build Backend Image') {
            steps {
                dir('backend') {
                    script {
                        docker.build("${DOCKER_REGISTRY_URL}/yashasvi-backend:${IMAGE_TAG}")
                    }
                }
            }
        }
        
        stage('Push Images') {
            steps {
                script {
                    docker.withRegistry("https://${DOCKER_REGISTRY_URL}", 'docker-registry') {
                        docker.image("${DOCKER_REGISTRY_URL}/yashasvi-frontend:${IMAGE_TAG}").push()
                        docker.image("${DOCKER_REGISTRY_URL}/yashasvi-frontend:${IMAGE_TAG}").push('latest')
                        docker.image("${DOCKER_REGISTRY_URL}/yashasvi-backend:${IMAGE_TAG}").push()
                        docker.image("${DOCKER_REGISTRY_URL}/yashasvi-backend:${IMAGE_TAG}").push('latest')
                    }
                }
            }
        }
        
        stage('Update Kubernetes Manifests') {
            steps {
                script {
                    sh """
                        sed -i 's|image: .*/yashasvi-frontend:.*|image: ${DOCKER_REGISTRY_URL}/yashasvi-frontend:${IMAGE_TAG}|g' k8s/frontend-deploy.yaml
                        sed -i 's|image: .*/yashasvi-backend:.*|image: ${DOCKER_REGISTRY_URL}/yashasvi-backend:${IMAGE_TAG}|g' k8s/backend-deploy.yaml
                    """
                }
            }
        }
        
        stage('Commit Manifest Changes') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                        sh '''
                            git config user.email "jenkins@yashasvi-duniya.com"
                            git config user.name "Jenkins CI"
                            git add k8s/frontend-deploy.yaml k8s/backend-deploy.yaml
                            git commit -m "Update image tags to ${IMAGE_TAG}" || true
                            git push https://${GIT_USER}:${GIT_TOKEN}@github.com/prathamvish333/YashasviDuniya.git HEAD:main
                        '''
                    }
                }
            }
        }
        
        stage('Trigger ArgoCD Sync') {
            steps {
                script {
                    sh '''
                        argocd app sync yashasvi-duniya --auth-token ${ARGOCD_TOKEN} --server argocd.example.com
                    '''
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
            // Add notification here (Slack, email, etc.)
        }
        failure {
            echo 'Pipeline failed!'
            // Add notification here
        }
    }
}
